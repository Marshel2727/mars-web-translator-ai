APP_NAME=Mars Web Translator AI
APP_ENV=development
API_V1_PREFIX=/api/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mars-translator-qwen3:latest
OLLAMA_CONNECT_TIMEOUT=5
REQUEST_TIMEOUT=120
MAX_BATCH_ITEMS=20
MAX_BATCH_CHARS=4000
MARS_API_TOKEN=replace-with-at-least-32-random-characters
MARS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
